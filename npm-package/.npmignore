# The published package is defined by "files" in package.json, which wins over this file.
# This is the belt to that braces: never pack a downloaded binary or a local install tree.
#
# bin/ is NOT listed. It holds the committed launcher (bin/voom), which is the package's
# entry point — the fetched binary is cached under the user's home instead. See download.js.
node_modules/
*.tgz
*.tar.gz
*.zip
